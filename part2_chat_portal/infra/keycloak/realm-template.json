{
  "realm": "agentcore-workshop",
  "enabled": true,
  "displayName": "AgentCore Workshop",
  "registrationAllowed": false,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 7200,
  "users": [
    {
      "username": "analyst",
      "enabled": true,
      "firstName": "选品",
      "lastName": "分析师",
      "email": "analyst@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "__ANALYST_PASSWORD__",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "workshop-web",
      "name": "选品分析门户（前端 SPA）",
      "description": "浏览器端 Authorization Code + PKCE，access token 用于调用 AgentCore Runtime",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "*"],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "runtime-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "analysis-runtime",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "analysis-agent",
      "name": "分析 Agent（M2M）",
      "description": "AgentCore Identity 用 client credentials 换取访问 Gateway 的 token",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__AGENT_CLIENT_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "analysis-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
