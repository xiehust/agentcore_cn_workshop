# =============================================================================
# Workshop 模型配置（填一次全局生效，无需在每个 Terminal 重复 export）
#
# 用法：把本文件复制为同目录下的 .env（CloudLab IDE 建栈时已自动复制好），
#       将尖括号占位符替换为讲师提供的实际值并保存。
#       所有步骤脚本（01/02/03/invoke_verify）会自动读取；已在终端里
#       export 的同名变量优先于本文件；含 <占位符> 的行自动跳过。
# 注意：本文件含密钥，已被 .gitignore 排除，不要提交或分享。
# =============================================================================

# ---- 对话/推理模型（场景 1 与场景 2 的 Agent 主模型，必填）----
# export OPENAI_BASE_URL=<OpenAI 兼容端点>/v1
# export OPENAI_API_KEY=<key>
# export MODEL_ID=<模型名>

# ---- mem0 长期记忆（场景 2 可选；不配置则记忆功能整体禁用，对话不受影响）----
# export MEM0_LLM_MODEL=<提取模型名>
# export MEM0_LLM_BASE_URL=<OpenAI 兼容端点>/v1
# export MEM0_LLM_API_KEY=<key>
# export MEM0_EMBEDDER_MODEL=<embedding 模型名>
# export MEM0_EMBEDDER_DIMS=1024

# ---- 中央 Keycloak（场景 2；由讲师发放，自建 Keycloak 时整段留空）----
# 学员账号 execute-api 受 ICP 备案登记限制时使用：Keycloak 集中跑在已备案账号，
# 以下凭证须与中央 realm 一致（与模型网关值同渠道发放）
# export KC_URL_OVERRIDE=<Keycloak 地址>
# export AGENT_CLIENT_SECRET=<client secret>
# export ANALYST_PASSWORD=<analyst 密码>
# export VIVIAN_PASSWORD=<vivian 密码>
# export MARCO_PASSWORD=<marco 密码>
